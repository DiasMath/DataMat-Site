rules_version = '2';

// Regras do Cloud Firestore para o formulário de contato do site DATAMAT.
// O site só pode CRIAR contatos válidos. Ninguém lê, altera ou apaga pelo
// site: os contatos são vistos pelo console do Firebase (ou por um painel
// interno com login, no futuro).
service cloud.firestore {
  match /databases/{database}/documents {

    match /contatos/{id} {
      allow read, update, delete: if false;
      allow create: if validContato(request.resource.data);
    }

    // Qualquer outra coleção fica fechada.
    match /{document=**} {
      allow read, write: if false;
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validContato(d) {
      return d.keys().hasOnly(['nome', 'empresa', 'email', 'whatsapp',
                               'solucao', 'mensagem', 'consentimento',
                               'origem', 'criadoEm'])
        && d.keys().hasAll(['nome', 'empresa', 'email', 'whatsapp',
                            'solucao', 'mensagem', 'consentimento', 'criadoEm'])
        && texto(d.nome, 2, 120)
        && texto(d.empresa, 1, 120)
        && texto(d.email, 5, 160)
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && texto(d.whatsapp, 8, 30)
        && texto(d.solucao, 1, 60)
        && texto(d.mensagem, 5, 3000)
        && (!('origem' in d) || texto(d.origem, 0, 100))
        && d.consentimento == true
        && d.criadoEm == request.time;
    }
  }
}
