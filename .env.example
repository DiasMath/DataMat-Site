# =====================================================================
# DATAMAT · variáveis do site
# No computador: copie para .env.local (não vai para o Git) e preencha.
# Na Vercel: cadastre as mesmas em Project → Settings → Environment
# Variables (Production e Preview) e faça um novo deploy.
# =====================================================================

# --- Obrigatória -----------------------------------------------------
# WhatsApp que recebe os contatos: DDI + DDD + número, só dígitos.
# Ex.: 5521999999999
VITE_WHATSAPP_NUMBER=

# --- Contatos do rodapé (o que ficar vazio não aparece) --------------
# E-mail de contato. Ex.: contato@datamat.com.br
VITE_CONTACT_EMAIL=
# Cidade/estado, igual ao Perfil da Empresa no Google. Ex.: Rio de Janeiro, RJ
VITE_CONTACT_CITY=
# Razão social e CNPJ (aparecem na última linha do rodapé)
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_CNPJ=
# Links completos das redes. Ex.: https://www.instagram.com/datamat
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=

# --- Contatos do rodapé (o que ficar vazio não aparece) ---------------
# E-mail de contato. Ex.: contato@datamat.com.br
VITE_CONTACT_EMAIL=
# Horário de atendimento. Ex.: Seg a sex, 9h às 18h
VITE_CONTACT_HOURS=
# Razão social e CNPJ (aparecem na linha final do rodapé)
VITE_CONTACT_LEGAL_NAME=
VITE_CONTACT_CNPJ=
# Links completos das redes. Ex.: https://www.instagram.com/datamat
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=

# --- Portal do cliente (opcional) -------------------------------------
# Link do portal. Preenchido = aparece "Área do cliente" no menu e no rodapé.
VITE_PORTAL_URL=

# --- Privacidade e LGPD (página /privacidade) -------------------------
# Quem responde pelos dados (controlador). Sem CNPJ, use o nome da pessoa
# responsável. Ex.: Filipe Rezende (DATAMAT)
VITE_PRIVACY_CONTROLLER=
# Encarregado de dados (opcional; pode ser a mesma pessoa)
VITE_PRIVACY_OFFICER=
# E-mail para pedidos sobre dados (vazio = usa VITE_CONTACT_EMAIL)
VITE_PRIVACY_EMAIL=

# --- Lançamento: domínio e Google ------------------------------------
# Endereço oficial, com https e sem barra no final.
# Ex.: https://www.datamat.com.br
# Vazio = usa o domínio de produção da Vercel.
SITE_URL=

# true = permite o Google indexar o site. Deixe false até o domínio
# oficial estar no ar. Deploys de preview da Vercel nunca são indexados.
PERMITIR_INDEXACAO=false

# --- Opcional: formulário de contato (Firebase / Firestore) -----------
# Veja firebase/LEIA-ME.md. Vazio = o formulário mostra o WhatsApp.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
