# Copie este arquivo para .env.local e preencha. O .env.local não vai para o Git.

# Número do WhatsApp com DDI e DDD, só números (ex.: 5521999999999)
VITE_WHATSAPP_NUMBER=

# Relatório Power BI "Publicar na Web" para a demonstração.
# ATENÇÃO: esse link é público para qualquer pessoa. Use só dados fictícios.
VITE_POWER_BI_EMBED_URL=

# Formulário de contato (Firebase / Cloud Firestore). Veja firebase/LEIA-ME.md
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
