# =====================================================================
# DATAMAT · variáveis do site
# No computador: copie para .env.local (não vai para o Git) e preencha.
# Na Vercel: cadastre as mesmas em Project → Settings → Environment
# Variables (Production e Preview) e faça um novo deploy.
# =====================================================================

# --- Obrigatória -----------------------------------------------------
# WhatsApp que recebe os contatos: DDI + DDD + número, só dígitos.
# Ex.: 5521999999999
VITE_WHATSAPP_NUMBER=

# --- Lançamento: domínio e Google ------------------------------------
# Endereço oficial, com https e sem barra no final.
# Ex.: https://www.datamat.com.br
# Vazio = usa o domínio de produção da Vercel.
SITE_URL=

# true = permite o Google indexar o site. Deixe false até o domínio
# oficial estar no ar. Deploys de preview da Vercel nunca são indexados.
PERMITIR_INDEXACAO=false

# --- Opcional: formulário de contato (Firebase / Firestore) -----------
# Veja firebase/LEIA-ME.md. Vazio = o formulário mostra o WhatsApp.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
